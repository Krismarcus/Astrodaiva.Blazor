@page "/year"
@inject Astrodaiva.Blazor.Services.AstroDbStore Store
@implements IDisposable
@using Astrodaiva.Data.Enums
@using Astrodaiva.Data.Models
@using System.Globalization
@using Astrodaiva.Blazor.Utils

<div class="year-topbar">
    <div class="year-topbar__inner">
        <div class="year-topbar__eyebrow">@(IsLt ? "Metų planetų judėjimas" : "Year planetary timeline")</div>
        <div class="year-switcher">
            <button class="year-arrow" @onclick="PrevYear" aria-label="Previous year">&#8592;</button>
            <span class="year-label">@_year</span>
            <button class="year-arrow" @onclick="NextYear" aria-label="Next year">&#8594;</button>
        </div>
    </div>
</div>

<div class="card year-surface" @onclick="() => _activeRetroKey = null">
    @if (_db is null)
    {
        <div>@(IsLt ? "Kraunama astro duomenų bazė…" : "Loading astro database…")</div>
    }
    else
    {
        <div class="timeline-container">
            <div class="timeline-content">
                <!-- Month labels -->
                <div class="month-labels-container">
                    <div class="planet-label-spacer"></div>
                    <div class="month-bar">
                        @foreach (var month in _monthSegments)
                        {
                            <span class="month-label @(IsMonthHighlighted(month) ? "highlighted" : "")"
                                  style="width:@Css.Pct(month.WidthPercentage)">
                                @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month.MonthStartDate.Month)
                            </span>
                        }
                    </div>
                </div>

                <!-- Planet Rows -->
                @foreach (var planetRow in _planetRows)
                {
                    <div class="planet-row">
                        <div class="planet-label">@GetRowLabel(planetRow.PlanetName)</div>

                        <div class="planet-bar-container">
                            @if (planetRow.PlanetName == Planet.Moon)
                            {
                                <div class="eclipse-bar-container eclipse-bar-summary-container"
                                     title="@BuildEclipsesSummaryTitle()"
                                     @onclick="ShowYearEclipsesSummary">
                                    <span class="eclipse-track"></span>
                                    @foreach (var eclipseSegment in GetEclipseSegments())
                                    {
                                        var eclipseKey = MakeRetroKey($"eclipse-{(eclipseSegment.IsSunEclipse ? "sun" : "moon")}", eclipseSegment.StartDate);
                                        <button type="button"
                                                class="eclipse-marker @(eclipseKey == _activeRetroKey ? "is-active" : null)"
                                                style="left:@Css.Pct(eclipseSegment.CenterPosition)"
                                                title="@(BuildEclipseTitle(eclipseSegment))"
                                                @onclick="() => ShowSpecificEclipse(eclipseSegment)"
                                                @onclick:stopPropagation="true"
                                                @onpointerdown="@(() => _activeRetroKey = eclipseKey)"
                                                @onpointerup="@(() => StateHasChanged())"
                                                @onpointercancel="@(() => _activeRetroKey = null)"
                                                @onpointerenter="@(() => OnEclipseHover(eclipseSegment))"
                                                @onpointerleave="OnEclipseHoverOut">
                                            <span class="eclipse-marker-dot @(eclipseSegment.IsSunEclipse ? "sun-eclipse-dot" : "moon-eclipse-dot")"></span>
                                            <span class="eclipse-day-marker">@eclipseSegment.StartDate.Day</span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                            <!-- Main Zodiac Bar -->
                            <div class="year-bar">
                                @foreach (var segment in planetRow.Segments)
                                {
                                    <span class="zodiac-bar @(IsSegmentSelected(planetRow.PlanetName, segment) ? "selected" : "")"
                                          style="background:@GetYearZodiacColor(segment.ZodiacSign);width:@Css.Pct(segment.WidthPercentage)"
                                          title="@(BuildSegmentTitle(planetRow.PlanetName, segment))"
                                          @onclick="() => SelectSegment(planetRow.PlanetName, segment)"
                                          @onmouseover="() => OnSegmentHover(segment)"
                                          @onmouseout="OnSegmentHoverOut">

                                        <span class="bar-content">
                                            @if (!(segment.ZodiacStartDate.Month == 1 && segment.ZodiacStartDate.Day == 1))
                                            {
                                                <span class="start-day">@segment.ZodiacStartDate.Day</span>
                                            }
                                            <img class="zodiac-symbol"
                                                 src="@Zodiac.ImagePath(segment.ZodiacSign)"
                                                 alt="@Zodiac.Name(segment.ZodiacSign)" />
                                        </span>
                                    </span>
                                }
                            </div>

                            <!-- Retrograde Bar -->
                            <div class="retrograde-bar-container">
                                @foreach (var retroSegment in GetRetrogradeSegments(planetRow.PlanetName))
                                {
                                    var key = MakeRetroKey(planetRow.PlanetName.ToString(), retroSegment.StartDate);
                                    <span class="retrograde-bar @(key == _activeRetroKey ? "is-active" : null)"
                                          style="width:@Css.Pct(retroSegment.WidthPercentage); left:@Css.Pct(retroSegment.LeftPosition)"
                                          title="@(BuildRetroTitle(planetRow.PlanetName, retroSegment))"
                                          @onpointerdown="@(() => _activeRetroKey = key)"
                                          @onpointerup="@(() => StateHasChanged())"
                                          @onpointercancel="@(() => _activeRetroKey = null)"
                                          @onpointerleave="@(() => _activeRetroKey = null)">
                                        <span class="retro-start-day">@retroSegment.StartDate.Day</span>
                                    </span>
                                }
                            </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Event Details Panel -->
        @if (_showEventDetails)
        {
            <div class="event-details-panel" @onclick="HideEventDetails">
                <div class="event-details-content" @onclick:stopPropagation="true">
                    <div class="event-details-header">
                        <h3>@_selectedPlanetInZodiacText</h3>
                        <button class="close-button" @onclick="HideEventDetails">&times;</button>
                    </div>
                    <div class="event-dates">
                        <span class="date-range">@_selectedStartDateText</span>
                        <span class="date-range">@_selectedEndDateText</span>
                    </div>
                    <div class="event-info @(_isEclipseSummaryList ? "eclipse-summary-list" : null)">
                        @if (_isEclipseSummaryList && _selectedPlanetInfoLines.Count > 0)
                        {
                            foreach (var infoLine in _selectedPlanetInfoLines)
                            {
                                <div class="eclipse-summary-line">@infoLine</div>
                            }
                        }
                        else
                        {
                            @_selectedPlanetInfo
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private AppDB? _db;
    private int _year = DateTime.Now.Year;
    private List<PlanetRow> _planetRows = new();
    private List<MonthSegment> _monthSegments = new();
    private bool _showEventDetails = false;
    private string _selectedPlanetInZodiacText = "";
    private string _selectedStartDateText = "";
    private string _selectedEndDateText = "";
    private string _selectedPlanetInfo = "";
    private bool _isEclipseSummaryList = false;
    private List<string> _selectedPlanetInfoLines = new();

    // Selection
    private Planet? _selectedPlanetName;
    private ZodiacSegment? _selectedSegment;

    // Hover
    private ZodiacSegment? _hoveredSegment;
    private int? _hoveredEclipseMonth;

    // Touch "active" retrograde key (planet + start date)
    private string? _activeRetroKey;
    private static string MakeRetroKey(string planetName, DateTime start)
        => $"{planetName}:{start:yyyyMMdd}";

    private bool IsLt => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt";

    private string GetRowLabel(Planet planet)
        => planet == Planet.Moon
            ? (IsLt ? "Užtemimai" : "Eclipses")
            : EnumText.GetPlanetName(planet);

    private string BuildSegmentTitle(Planet planet, ZodiacSegment segment)
        => IsLt
            ? $"{EnumText.GetPlanetName(planet)}: {EnumText.GetZodiacName(segment.ZodiacSign)} {segment.ZodiacStartDate.ToString("MMM d", CultureInfo.CurrentCulture)} - {segment.ZodiacEndDate.ToString("MMM d", CultureInfo.CurrentCulture)}"
            : $"{EnumText.GetPlanetName(planet)}: {Zodiac.Name(segment.ZodiacSign)} {segment.ZodiacStartDate:MMM d} - {segment.ZodiacEndDate:MMM d}";

    private static string GetYearZodiacColor(ZodiacSign sign) => sign switch
    {
        ZodiacSign.Aries or ZodiacSign.Leo or ZodiacSign.Sagittarius => "#B97958",
        ZodiacSign.Taurus or ZodiacSign.Virgo or ZodiacSign.Capricorn => "#8B8D5A",
        ZodiacSign.Gemini or ZodiacSign.Libra or ZodiacSign.Aquarius => "#8FAF9A",
        ZodiacSign.Cancer or ZodiacSign.Scorpio or ZodiacSign.Pisces => "#567A84",
        _ => "#8FAF9A"
    };

    private string BuildRetroTitle(Planet planet, RetrogradeSegment segment)
        => IsLt
            ? $"{EnumText.GetPlanetName(planet)} retrogradinis: {segment.StartDate.ToString("MMM d", CultureInfo.CurrentCulture)} - {segment.EndDate.ToString("MMM d", CultureInfo.CurrentCulture)}"
            : $"{EnumText.GetPlanetName(planet)} Retrograde: {segment.StartDate:MMM d} - {segment.EndDate:MMM d}";


    private string BuildEclipseTitle(EclipseSegment segment)
        => IsLt
            ? $"{(segment.IsSunEclipse ? "Saulės užtemimas" : "Mėnulio užtemimas")}: {segment.StartDate.ToString("MMMM d", CultureInfo.CurrentCulture)}"
            : $"{(segment.IsSunEclipse ? "Sun Eclipse" : "Moon Eclipse")}: {segment.StartDate:MMMM d}";

    private string BuildEclipsesSummaryTitle()
        => IsLt ? "Rodyti visų metų užtemimus" : "Show all eclipses of the year";

    // Order shown in the UI
    private static readonly Planet[] PlanetsOrder = new[]
    {
        Planet.Sun, Planet.Moon, Planet.Mercury, Planet.Venus, Planet.Mars, Planet.Jupiter,
        Planet.Saturn, Planet.Uranus, Planet.Neptune, Planet.Pluto,
        Planet.Selena, Planet.Lilith, Planet.Rahu, Planet.Ketu
    };

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        _db = await Store.EnsureLoadedAsync();
        GenerateCalendar();
    }

    private void OnStoreChanged()
    {
        _db = Store.Db;
        ClearSelection();
        GenerateCalendar();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
    }

    private void PrevYear()
    {
        _year--;
        ClearSelection();
        GenerateCalendar();
        StateHasChanged();
    }

    private void NextYear()
    {
        _year++;
        ClearSelection();
        GenerateCalendar();
        StateHasChanged();
    }

    private void SelectSegment(Planet planetName, ZodiacSegment segment)
    {
        if (segment == null) return;

        if (_selectedPlanetName == planetName && AreSegmentsEqual(_selectedSegment, segment))
        {
            ClearSelection();
            StateHasChanged();
            return;
        }

        var infoSourceItem = _db?.PlanetInZodiacsDB?.FirstOrDefault(p =>
            p.Planet == planetName && p.ZodiacSign == segment.ZodiacSign);

        _selectedPlanetInZodiacText = EnumText.In(planetName, segment.ZodiacSign);
        _selectedStartDateText = IsLt ? $"Nuo {segment.ZodiacStartDate.ToString("MMMM d, HH:mm", CultureInfo.CurrentCulture)}" : $"From {segment.ZodiacStartDate:MMMM d, HH:mm}";
        _selectedEndDateText = IsLt ? $"Iki {segment.ZodiacEndDate.ToString("MMMM d, HH:mm", CultureInfo.CurrentCulture)}" : $"To {segment.ZodiacEndDate:MMMM d, HH:mm}";
        _selectedPlanetInfo = GetPlanetInZodiacInfo(infoSourceItem);

        _selectedPlanetName = planetName;
        _selectedSegment = segment;
        _showEventDetails = true;
        _activeRetroKey = null;
        StateHasChanged();
    }

    private void OnSegmentHover(ZodiacSegment segment)
    {
        _hoveredSegment = segment;
        StateHasChanged();
    }

    private string GetPlanetInZodiacInfo(PlanetInZodiacDetails? details)
    {
        if (details is null)
            return IsLt ? "Informacijos nėra." : "No information available.";

        if (IsLt)
            return string.IsNullOrWhiteSpace(details.PlanetInZodiacInfo)
                ? "Informacijos nėra."
                : details.PlanetInZodiacInfo;

        if (!string.IsNullOrWhiteSpace(details.PlanetInZodiacInfoEn))
            return details.PlanetInZodiacInfoEn;

        return string.IsNullOrWhiteSpace(details.PlanetInZodiacInfo)
            ? "No information available."
            : details.PlanetInZodiacInfo;
    }

    private void OnSegmentHoverOut()
    {
        _hoveredSegment = null;
        StateHasChanged();
    }

    private bool IsMonthHighlighted(MonthSegment month)
    {
        if (_hoveredEclipseMonth.HasValue)
            return month.MonthStartDate.Month == _hoveredEclipseMonth.Value;

        if (_hoveredSegment == null) return false;

        return _hoveredSegment.ZodiacStartDate <= month.MonthEndDate &&
               _hoveredSegment.ZodiacEndDate >= month.MonthStartDate;
    }

    private void OnEclipseHover(EclipseSegment eclipse)
    {
        _hoveredEclipseMonth = eclipse.StartDate.Month;
        StateHasChanged();
    }

    private void OnEclipseHoverOut()
    {
        _hoveredEclipseMonth = null;
        _activeRetroKey = null;
        StateHasChanged();
    }

    private List<RetrogradeSegment> GetRetrogradeSegments(Planet planet)
    {
        var segments = new List<RetrogradeSegment>();
        var activeAstroEvents = _db?.AstroEventsDB?
            .Where(e => e.Date.Year == _year)
            .OrderBy(e => e.Date)
            .ToList();

        if (activeAstroEvents == null || activeAstroEvents.Count == 0)
            return segments;

        bool? lastRetrograde = null;
        DateTime? startDate = null;

        foreach (var astroEvent in activeAstroEvents)
        {
            bool? current = GetPlanetRetrogradeState(astroEvent, planet);
            if (current == null) continue;

            if (lastRetrograde == null || current != lastRetrograde)
            {
                if (startDate != null && lastRetrograde == true)
                {
                    segments.Add(CreateRetrogradeSegment(startDate.Value, astroEvent.Date.AddDays(-1)));
                }

                if (current == true)
                    startDate = astroEvent.Date;

                lastRetrograde = current;
            }
        }

        if (startDate != null && lastRetrograde == true)
        {
            var lastEvent = activeAstroEvents.Last();
            segments.Add(CreateRetrogradeSegment(startDate.Value, lastEvent.Date));
        }

        return segments;
    }

    private RetrogradeSegment CreateRetrogradeSegment(DateTime startDate, DateTime endDate)
    {
        var startOfYear = new DateTime(_year, 1, 1);
        var daysFromStart = (startDate - startOfYear).Days;
        var duration = (endDate - startDate).Days + 1;

        var leftPosition = (daysFromStart * 100.0) / 365;
        var widthPercentage = (duration * 100.0) / 365;

        return new RetrogradeSegment
        {
            StartDate = startDate,
            EndDate = endDate,
            WidthPercentage = widthPercentage,
            LeftPosition = leftPosition
        };
    }

    private bool? GetPlanetRetrogradeState(AstroEvent e, Planet planet) => planet switch
    {
        Planet.Mercury => e.MercuryInZodiac?.IsRetrograde,
        Planet.Venus => e.VenusInZodiac?.IsRetrograde,
        Planet.Mars => e.MarsInZodiac?.IsRetrograde,
        Planet.Jupiter => e.JupiterInZodiac?.IsRetrograde,
        Planet.Saturn => e.SaturnInZodiac?.IsRetrograde,
        Planet.Uranus => e.UranusInZodiac?.IsRetrograde,
        Planet.Neptune => e.NeptuneInZodiac?.IsRetrograde,
        Planet.Pluto => e.PlutoInZodiac?.IsRetrograde,
        _ => null // Sun/Nodes/Selena/Lilith usually not used for retrograde bars
    };

    private List<EclipseSegment> GetEclipseSegments()
    {
        var eclipseEvents = _db?.AstroEventsDB?
            .Where(e => e.Date.Year == _year)
            .Where(e => e.SunEclipse || e.MoonEclipse)
            .OrderBy(e => e.Date)
            .ToList();

        if (eclipseEvents == null || eclipseEvents.Count == 0)
            return new List<EclipseSegment>();

        var segments = new List<EclipseSegment>();

        foreach (var e in eclipseEvents)
        {
            if (e.SunEclipse)
                segments.Add(CreateEclipseSegment(e.Date, isSunEclipse: true));

            if (e.MoonEclipse)
                segments.Add(CreateEclipseSegment(e.Date, isSunEclipse: false));
        }

        return segments
            .OrderBy(s => s.StartDate)
            .ThenByDescending(s => s.IsSunEclipse)
            .ToList();
    }

    private EclipseSegment CreateEclipseSegment(DateTime date, bool isSunEclipse)
    {
        var startOfYear = new DateTime(_year, 1, 1);
        var daysFromStart = (date - startOfYear).Days;
        var widthPercentage = Math.Max(0.12, 100.0 / 365.0);
        var leftPosition = (daysFromStart * 100.0) / 365;
        var centerPosition = leftPosition + (widthPercentage / 2.0);

        return new EclipseSegment
        {
            StartDate = date,
            EndDate = date,
            WidthPercentage = widthPercentage,
            LeftPosition = leftPosition,
            CenterPosition = centerPosition,
            IsSunEclipse = isSunEclipse
        };
    }

    private void ShowYearEclipsesSummary()
    {
        var eclipses = GetEclipseSegments();
        _selectedPlanetInZodiacText = IsLt ? $"Užtemimai {_year}" : $"Eclipses {_year}";
        _selectedStartDateText = IsLt ? $"Metai: {_year}" : $"Year: {_year}";
        _selectedEndDateText = IsLt
            ? $"Iš viso: {eclipses.Count}"
            : $"Total: {eclipses.Count}";

        _selectedPlanetInfo = eclipses.Count == 0
            ? (IsLt ? "Šiais metais užtemimų nerasta." : "No eclipses found in this year.")
            : string.Join("\n", eclipses.Select(e =>
                IsLt
                    ? $"• {(e.IsSunEclipse ? "Saulės užtemimas" : "Mėnulio užtemimas")} – {e.StartDate.ToString("MMMM d", CultureInfo.CurrentCulture)}"
                    : $"• {(e.IsSunEclipse ? "Sun eclipse" : "Moon eclipse")} – {e.StartDate.ToString("MMMM d", CultureInfo.CurrentCulture)}"));

        _showEventDetails = true;
        _selectedPlanetName = Planet.Moon;
        _selectedSegment = null;
        StateHasChanged();
    }

    private void ShowSpecificEclipse(EclipseSegment eclipse)
    {
        _selectedPlanetInZodiacText = IsLt
            ? (eclipse.IsSunEclipse ? "Saulės užtemimas" : "Mėnulio užtemimas")
            : (eclipse.IsSunEclipse ? "Sun Eclipse" : "Moon Eclipse");

        _selectedStartDateText = IsLt
            ? $"Data: {eclipse.StartDate.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture)}"
            : $"Date: {eclipse.StartDate.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture)}";

        _selectedEndDateText = IsLt ? $"Metai: {_year}" : $"Year: {_year}";
        _selectedPlanetInfo = IsLt
            ? $"{(eclipse.IsSunEclipse ? "Saulės" : "Mėnulio")} užtemimas įvyks {eclipse.StartDate.ToString("MMMM d", CultureInfo.CurrentCulture)}."
            : $"This {(eclipse.IsSunEclipse ? "sun" : "moon")} eclipse happens on {eclipse.StartDate.ToString("MMMM d", CultureInfo.CurrentCulture)}.";

        _selectedPlanetInfoLines.Clear();
        _isEclipseSummaryList = false;
        _showEventDetails = true;
        StateHasChanged();
    }

    private void HideEventDetails()
    {
        _showEventDetails = false;
        _activeRetroKey = null;
        _hoveredEclipseMonth = null;
        StateHasChanged();
    }

    private bool IsSegmentSelected(Planet planetName, ZodiacSegment segment)
        => _selectedPlanetName == planetName && AreSegmentsEqual(_selectedSegment, segment);

    private static bool AreSegmentsEqual(ZodiacSegment? a, ZodiacSegment? b)
        => a is not null && b is not null
           && a.ZodiacSign == b.ZodiacSign
           && a.ZodiacStartDate == b.ZodiacStartDate
           && a.ZodiacEndDate == b.ZodiacEndDate;

    private void ClearSelection()
    {
        _showEventDetails = false;
        _selectedPlanetName = null;
        _selectedSegment = null;
        _selectedPlanetInZodiacText = "";
        _selectedStartDateText = "";
        _selectedEndDateText = "";
        _selectedPlanetInfo = "";
        _selectedPlanetInfoLines.Clear();
        _isEclipseSummaryList = false;
        _hoveredSegment = null;
        _hoveredEclipseMonth = null;
        _activeRetroKey = null;
    }

    private void GenerateCalendar()
    {
        _planetRows.Clear();
        _monthSegments.Clear();

        var events = _db?.AstroEventsDB?
            .Where(e => e.Date.Year == _year)
            .OrderBy(e => e.Date)
            .ToList();

        if (events == null || events.Count == 0) return;

        GenerateMonthSegments(events);
        GeneratePlanetSegments(events);
    }

    private void GenerateMonthSegments(List<AstroEvent> events)
    {
        var lastEvent = events.Last();

        for (int month = 1; month <= 12; month++)
        {
            var monthStart = new DateTime(_year, month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            if (monthStart > lastEvent.Date) break;
            if (monthEnd > lastEvent.Date) monthEnd = lastEvent.Date;

            var daysInMonth = (monthEnd - monthStart).Days + 1;
            var width = (daysInMonth * 100.0) / 365;

            _monthSegments.Add(new MonthSegment
            {
                MonthStartDate = monthStart,
                MonthEndDate = monthEnd,
                WidthPercentage = width
            });
        }
    }

    private void GeneratePlanetSegments(List<AstroEvent> events)
    {
        foreach (var planet in PlanetsOrder)
        {
            var segments = BuildPlanetSegments(events, planet);
            _planetRows.Add(new PlanetRow { PlanetName = planet, Segments = segments });
        }
    }

    private List<ZodiacSegment> BuildPlanetSegments(List<AstroEvent> events, Planet planet)
    {
        var segments = new List<ZodiacSegment>();
        ZodiacSign? lastSign = null;
        DateTime? startDate = null;

        foreach (var e in events)
        {
            var current = GetPlanetZodiacSign(e, planet);
            if (current == null) continue;

            if (lastSign == null || current != lastSign)
            {
                if (startDate != null && lastSign != null)
                    segments.Add(CreateZodiacSegment(lastSign.Value, startDate.Value, e.Date.AddDays(-1)));

                startDate = e.Date;
                lastSign = current;
            }
        }

        if (startDate != null && lastSign != null)
        {
            var lastEvent = events.Last();
            segments.Add(CreateZodiacSegment(lastSign.Value, startDate.Value, lastEvent.Date));
        }

        return segments;
    }

    private static ZodiacSegment CreateZodiacSegment(ZodiacSign sign, DateTime start, DateTime end)
    {
        var duration = (end - start).Days + 1;
        var width = (duration * 100.0) / 365;

        return new ZodiacSegment
        {
            ZodiacSign = sign,
            ZodiacStartDate = start,
            ZodiacEndDate = end,
            Duration = duration,
            WidthPercentage = width
        };
    }

    private static ZodiacSign? GetPlanetZodiacSign(AstroEvent e, Planet planet) => planet switch
    {
        Planet.Sun => e.SunInZodiac?.NewZodiacSign,
        Planet.Mercury => e.MercuryInZodiac?.NewZodiacSign,
        Planet.Venus => e.VenusInZodiac?.NewZodiacSign,
        Planet.Mars => e.MarsInZodiac?.NewZodiacSign,
        Planet.Jupiter => e.JupiterInZodiac?.NewZodiacSign,
        Planet.Saturn => e.SaturnInZodiac?.NewZodiacSign,
        Planet.Uranus => e.UranusInZodiac?.NewZodiacSign,
        Planet.Neptune => e.NeptuneInZodiac?.NewZodiacSign,
        Planet.Pluto => e.PlutoInZodiac?.NewZodiacSign,
        Planet.Selena => e.SelenaInZodiac?.NewZodiacSign,
        Planet.Lilith => e.LilithInZodiac?.NewZodiacSign,
        Planet.Rahu => e.RahuInZodiac?.NewZodiacSign,
        Planet.Ketu => e.KetuInZodiac?.NewZodiacSign,
        _ => null
    };

    // Helper classes
    public class PlanetRow
    {
        public Planet PlanetName { get; set; }
        public List<ZodiacSegment> Segments { get; set; } = new();
    }

    public class MonthSegment
    {
        public DateTime MonthStartDate { get; set; }
        public DateTime MonthEndDate { get; set; }
        public double WidthPercentage { get; set; }
    }

    public class ZodiacSegment
    {
        public ZodiacSign ZodiacSign { get; set; }
        public DateTime ZodiacStartDate { get; set; }
        public DateTime ZodiacEndDate { get; set; }
        public int Duration { get; set; }
        public double WidthPercentage { get; set; }
    }

    public class RetrogradeSegment
    {
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public double WidthPercentage { get; set; }
        public double LeftPosition { get; set; }
    }

    public class EclipseSegment
    {
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public double WidthPercentage { get; set; }
        public double LeftPosition { get; set; }
