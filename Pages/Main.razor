@page "/"
@inject Astrodaiva.Blazor.Services.AstroDbStore Store
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Astrodaiva.Data
@using Astrodaiva.Data.Models
@using System.Globalization
@using System.Linq
@using Astrodaiva.Data.Enums
@using Astrodaiva.Blazor.Utils
@using System.Net
@using Microsoft.JSInterop

@if (_db is null)
{
    <div class="card">@(IsLt ? "Kraunama astro duomenų bazė…" : "Loading astro database…")</div>
}
else
{
    <div class="card split-2">
        <!-- LEFT: calendar -->
        <div class="tabs-panel">
            <div class="calendar-shell">
                <div class="month-header month-header--inside">
                    <button type="button" class="nav-btn" @onclick="PrevMonth">◀</button>
                    <div class="month-title">@_current.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</div>
                    <button type="button" class="nav-btn" @onclick="NextMonth">▶</button>
                </div>

                <div class="weekday-header">
                @foreach (var wd in _weekdaysShort)
                {
                    <div class="weekday-cell">@wd</div>
                }
            </div>

                <div class="tabs-strip-grid">
                @foreach (var week in _weeks)
                {
                    foreach (var day in week)
                    {
                        if (day is null)
                        {
                            <div class="daycell-empty"></div>
                        }
                        else
                        {
                            var d = day.Value;
                            var active = d == _selectedDay ? "active" : "";
                            var today = IsToday(d) ? "is-today" : "";
                            var e = _monthEvents.FirstOrDefault(x => x.Date.Day == d);
                            string? moonDay = e?.MoonDay is not null ? GetMoonDayKey((int)e.MoonDay.NewMoonDay) : null;
                            var q = GetActivityQuality(e, _selectedActivity);
                            var qClass = GetQualityClass(q);
                            var showIndicator = q == ActivityQuality.Good || q == ActivityQuality.Bad;

                            <button @key="d"
                                    type="button"
                                    class="daycard @active @today"
                                    title="@($"{_current:MMMM yyyy}")"
                                    @onclick="@(() => SelectDay(d))">
                                <span class="daycard-day">@d</span>
                                <span class="daycard-icon">
                                    @if (!string.IsNullOrEmpty(moonDay))
                                    {
                                        <img src="@($"img/zodiac/{moonDay}.png")" alt="@moonDay" />
                                    }
                                </span>
                                <span class="daycard-indicator @(showIndicator ? "has-indicator" : "is-empty")" title="@GetQualityTitle(q)">
                                    @if (showIndicator)
                                    {
                                        <span class="quality-dot @qClass"></span>
                                    }
                                </span>
                            </button>
                        }
                    }
                }
                </div>
            </div>

            <!-- Activity selector (left side, under day cards) -->
            <div class="activity-selector activity-selector--inline">
                <div class="activity-selector__title">@(IsLt ? "Pasirinkite veiklą" : "Select activity")</div>
                <div class="activity-grid js-activity-grid">
                    <span class="activity-grid__slider" aria-hidden="true"></span>
                    @foreach (var a in _activities)
                    {
                        var sel = a == _selectedActivity ? "selected" : "";
                        var activityTitle = EnumText.GetActivityName(a);

                        <button type="button"
                                class="activity-btn @sel" data-activity-btn="true"
                                title="@activityTitle"
                                @onclick="(() => SelectActivity(a))">
                            <span class="activity-btn__icon" aria-hidden="true">
                                <img class="activity-icon-img" src="@GetActivityIconPath(a)" alt="" />
                            </span>
                            <span class="activity-btn__label">@GetActivityShortLabel(a)</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: desktop-only panel -->
        <div class="tab-content day-layout desktop-right">
            @RightPanelContent()
        </div>
    </div>

    <!-- MOBILE OVERLAY (CSS decides visibility on ≤900px) -->
    <div class="mobile-overlay @( _overlayOpen ? "open" : "" )" aria-hidden="@(!_overlayOpen)">
        <div class="mobile-overlay__backdrop" @onclick="CloseOverlay"></div>
        <div class="mobile-overlay__panel" role="dialog" aria-modal="true">
            <div class="mobile-overlay__header">
                <button type="button" class="overlay-close" @onclick="CloseOverlay">✕</button>
            </div>
            <div class="mobile-overlay__body">
                @RightPanelContent()
            </div>
        </div>
    </div>

    <!-- INFO MODAL (Moon-day / Planet-in-zodiac details) -->
    @if (_infoModalOpen)
    {
        <div class="info-modal" role="dialog" aria-modal="true">
            <div class="info-modal__backdrop" @onclick="CloseInfoModal"></div>
            <div class="info-modal__panel">
                <div class="info-modal__header">
                    <div class="info-modal__title">@_infoModalTitle</div>
                    <button type="button" class="info-modal__close" title="@(IsLt ? "Uždaryti" : "Close")" @onclick="CloseInfoModal">✕</button>
                </div>
                <div class="info-modal__body">
                    @_infoModalBody
                </div>
            </div>
        </div>
    }
}

@code {
    private AppDB? _db;
    private List<AstroEvent> _monthEvents = new();
    private DateTime _current = DateTime.Today;
    private int _year;
    private int _month;
    private int _selectedDay;

    // Activity selector state (used for calendar dots)
    private ActivitySymbol _selectedActivity = ActivitySymbol.ImportantTasks;
    private static readonly ActivitySymbol[] _activities = new[]
    {
        ActivitySymbol.ImportantTasks,
        ActivitySymbol.Contracts,
        ActivitySymbol.BuyStuff,
        ActivitySymbol.Meetings,
        ActivitySymbol.Technologies,
        ActivitySymbol.Love,
        ActivitySymbol.Beauty,
        ActivitySymbol.Barber,
        ActivitySymbol.Gardening,
        ActivitySymbol.Travel,
    };

    // UI state: no JS — CSS shows overlay only on ≤900px
    private bool _overlayOpen;
    private bool? _syncedOverlayOpen;

    // UI state: details popup
    private bool _infoModalOpen;
    private string _infoModalTitle = "";
    private MarkupString _infoModalBody;

    // Left panel calendar data
    private List<List<int?>> _weeks = new();
    private string[] _weekdaysShort => GetWeekdayShortNames();

    private bool IsLt => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt";

    private static string[] GetWeekdayShortNames()
    {
        var culture = CultureInfo.CurrentCulture;
        return new[]
        {
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Monday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Tuesday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Wednesday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Thursday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Friday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Saturday),
            culture.DateTimeFormat.GetShortestDayName(DayOfWeek.Sunday),
        };
    }

    private IEnumerable<AstroEvent> DayEvents
        => _monthEvents.Where(e => e.Date.Day == _selectedDay).OrderBy(e => e.Date);

    private void OpenEventTextDetails()
    {
        var items = GetEventDisplayItems()
            .Where(item => !string.IsNullOrWhiteSpace(item.Description))
            .ToList();

        if (items.Count == 0)
            return;

        if (items.Count == 1)
        {
            var item = items[0];
            _infoModalTitle = item.Title;
            _infoModalBody = ToMultilineMarkup(item.Description, IsLt ? "Aprašymo dar nėra." : "No description saved yet.");
            _infoModalOpen = true;
            return;
        }

        _infoModalTitle = IsLt ? "Dienos įvykiai" : "Day events";
        _infoModalBody = BuildEventTextModalBody(items);
        _infoModalOpen = true;
    }

    private void HandleEventTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
            OpenEventTextDetails();
    }

    private List<EventDisplayItem> GetEventDisplayItems()
        => DayEvents
            .Select(BuildEventDisplayItem)
            .Where(item => !string.IsNullOrWhiteSpace(item.Title))
            .ToList();

    private EventDisplayItem BuildEventDisplayItem(AstroEvent e)
    {
        var title = LocalizedEventText(e.EventText, e.EventTextEn);
        var description = LocalizedEventText(e.EventDescription, e.EventDescriptionEn);

        if (string.IsNullOrWhiteSpace(title) && e.PlanetEvents is { Count: > 0 })
        {
            title = string.Join(", ", e.PlanetEvents.Select(pe =>
                $"{EnumText.GetPlanetName(pe.Planet1)} {pe.AspectSymbol} {EnumText.GetPlanetName(pe.Planet2)}"));
        }

        if (string.IsNullOrWhiteSpace(title) && !string.IsNullOrWhiteSpace(description))
            title = IsLt ? "Dienos įvykis" : "Day event";

        return new EventDisplayItem(title.Trim(), description.Trim());
    }

    private string LocalizedEventText(string? lt, string? en)
    {
        if (IsLt)
            return !string.IsNullOrWhiteSpace(lt) ? lt : en ?? "";

        return !string.IsNullOrWhiteSpace(en) ? en : lt ?? "";
    }

    private sealed record EventDisplayItem(string Title, string Description);

    private static string GetSignName(int sign) => EnumText.GetZodiacName((ZodiacSign)sign);
    private static string GetSignLocative(int sign) => EnumText.GetZodiacLocative((ZodiacSign)sign);
    private static string GetMoonDayName(int symbol) => EnumText.GetMoonDayName((MoonDaySymbol)symbol);
    private static string GetMoonDayKey(int symbol) => EnumText.GetMoonDayKey((MoonDaySymbol)symbol);
    private bool IsToday(int day)
        => _year == DateTime.Today.Year && _month == DateTime.Today.Month && day == DateTime.Today.Day;

    private static string BuildZodiacOrTransitionBlock(string planetName, PlanetInZodiac? p)
    {
        if (p is null)
            return "<div class=\"muted\">—</div>";

        var newName = GetSignName((int)p.NewZodiacSign);
        var newLocative = GetSignLocative((int)p.NewZodiacSign);
        var newIcon = EnumText.GetZodiacKey(p.NewZodiacSign);

        // default: show the current (new) sign
        if (!p.IsZodiacTransitioning)
        {
            var label = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt" ? $"{planetName} {newLocative}" : $"{planetName} in {newName}";
            return $"<div class=\"astro-label\">{label}</div>" +
                   $"<div class=\"astro-zodiac-current\" title=\"{label}\">" +
                   $"<img alt=\"{planetName} sign\" src=\"img/zodiac/{newIcon}.png\" width=\"64\" height=\"64\" />" +
                   "</div>";
        }

        // transitioning: show previous sign (left) + transition time (center) + new sign (right)
        var prevName = GetSignName((int)p.PreviousZodiacSign);
        var prevIcon = EnumText.GetZodiacKey(p.PreviousZodiacSign);
        var timeText = p.TransitionTime.ToString("HH:mm", CultureInfo.InvariantCulture);
        var transitionTitle = $"{planetName}: {prevName} - {timeText} - {newName}";

        return $@"<div class=""astro-label"">{transitionTitle}</div>
<div class=""astro-transition"" title=""{transitionTitle}"">
  <img class=""astro-transition__sign astro-transition__sign--previous"" alt=""Previous {planetName} sign"" src=""img/zodiac/{prevIcon}.png"" />
  <span class=""astro-transition__connector"" aria-hidden=""true""></span>
  <span class=""astro-transition__time"">{timeText}</span>
  <span class=""astro-transition__connector"" aria-hidden=""true""></span>
  <img class=""astro-transition__sign astro-transition__sign--new"" alt=""New {planetName} sign"" src=""img/zodiac/{newIcon}.png"" />
</div>";
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        _db = await Store.EnsureLoadedAsync();
        _year = _current.Year;
        _month = _current.Month;
        _selectedDay = _current.Day;
        RecomputeMonth();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("activitySlider.update", ".js-activity-grid");

        if (firstRender)
        {
            await JS.InvokeVoidAsync("activitySlider.init", ".js-activity-grid");
        }

        await SyncMobileOverlayLayerAsync();
    }

    private void OnStoreChanged()
    {
        _db = Store.Db;
        RecomputeMonth();
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        await JS.InvokeVoidAsync("modalLayer.setMobileDayOverlayOpen", false);
    }

    private async Task SyncMobileOverlayLayerAsync()
    {
        if (_syncedOverlayOpen == _overlayOpen)
            return;

        _syncedOverlayOpen = _overlayOpen;
        await JS.InvokeVoidAsync("modalLayer.setMobileDayOverlayOpen", _overlayOpen);
    }

    private void RecomputeMonth()
    {
        RecomputeMonthEvents();
        BuildWeeks();
        var dim = DateTime.DaysInMonth(_year, _month);
        if (_selectedDay < 1) _selectedDay = 1;
        if (_selectedDay > dim) _selectedDay = dim;
        _current = new DateTime(_year, _month, _selectedDay);
    }

    private void RecomputeMonthEvents()
    {
        _monthEvents = _db?.AstroEventsDB?
            .Where(x => x.Date.Year == _year && x.Date.Month == _month)
            .OrderBy(x => x.Date)
            .ToList() ?? new List<AstroEvent>();
    }

    // Build Monday-first 7-column weeks
    private void BuildWeeks()
    {
        _weeks.Clear();
        var firstOfMonth = new DateTime(_year, _month, 1);
        var dim = DateTime.DaysInMonth(_year, _month);

        int mondayFirstIndex(int dow) => ((dow - (int)DayOfWeek.Monday) + 7) % 7;
        int startOffset = mondayFirstIndex((int)firstOfMonth.DayOfWeek);

        var days = Enumerable.Repeat<int?>(null, startOffset)
                             .Concat(Enumerable.Range(1, dim).Select(i => (int?)i))
                             .ToList();

        int pad = (7 - (days.Count % 7)) % 7;
        if (pad > 0) days.AddRange(Enumerable.Repeat<int?>(null, pad));

        for (int i = 0; i < days.Count; i += 7)
            _weeks.Add(days.Skip(i).Take(7).ToList());
    }

    private async Task SelectDay(int day)
    {
        _selectedDay = day;
        _current = new DateTime(_year, _month, _selectedDay);

        // Always set true; CSS shows only on ≤900px
        _overlayOpen = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task PrevMonth()
    {
        var d = new DateTime(_year, _month, 1).AddMonths(-1);
        _year = d.Year; _month = d.Month; _selectedDay = 1;
        RecomputeMonth();
        _overlayOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task NextMonth()
    {
        var d = new DateTime(_year, _month, 1).AddMonths(1);
        _year = d.Year; _month = d.Month; _selectedDay = 1;
        RecomputeMonth();
        _overlayOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseOverlay() => _overlayOpen = false;

    private async Task SelectActivity(ActivitySymbol a)
    {
        _selectedActivity = a;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetActivityIconPath(ActivitySymbol a) => a switch
    {
        ActivitySymbol.Barber => "img/activity/barber.svg",
        ActivitySymbol.Beauty => "img/activity/beauty.svg",
        ActivitySymbol.BuyStuff => "img/activity/shopping.svg",
        ActivitySymbol.Contracts => "img/activity/contracts.svg",
        ActivitySymbol.ImportantTasks => "img/activity/tasks.svg",
        ActivitySymbol.Love => "img/activity/love.svg",
        ActivitySymbol.Meetings => "img/activity/meetings.svg",
        ActivitySymbol.NewIdeas => "img/activity/ideas.svg",
        ActivitySymbol.Gardening => "img/activity/garden.svg",
        ActivitySymbol.Technologies => "img/activity/tech.svg",
        ActivitySymbol.Travel => "img/activity/travel.svg",
        _ => "img/activity/tasks.svg"
    };

    private static string GetActivityShortLabel(ActivitySymbol a)
        => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt"
            ? EnumText.GetActivityName(a)
            : a switch
            {
                ActivitySymbol.BuyStuff => "Buy",
                ActivitySymbol.ImportantTasks => "Tasks",
                ActivitySymbol.Technologies => "Tech",
                ActivitySymbol.Meetings => "Meet",
                ActivitySymbol.Contracts => "Contracts",
                ActivitySymbol.Barber => "Barber",
                ActivitySymbol.Beauty => "Beauty",
                ActivitySymbol.Love => "Love",
                ActivitySymbol.Gardening => "Gardening",
                ActivitySymbol.Travel => "Travel",
                _ => EnumText.GetActivityName(a)
            };

    private static ActivityQuality GetActivityQuality(AstroEvent? e, ActivitySymbol a)
    {
        if (e is null) return ActivityQuality.None;
        return a switch
        {
            ActivitySymbol.Barber => e.Barber,
            ActivitySymbol.Beauty => e.Beauty,
            ActivitySymbol.BuyStuff => e.Buystuff,
            ActivitySymbol.Contracts => e.Contracts,
            ActivitySymbol.ImportantTasks => e.ImportantTasks,
            ActivitySymbol.Love => e.Love,
            ActivitySymbol.Meetings => e.Meetings,
            ActivitySymbol.NewIdeas => e.NewIdeas,
            ActivitySymbol.Gardening => e.Gardening,
            ActivitySymbol.Technologies => e.Tech,
            ActivitySymbol.Travel => e.Travel,
            _ => ActivityQuality.None
        };
    }

    private static string GetQualityClass(ActivityQuality q) => q switch
    {
        ActivityQuality.Good => "good",
        ActivityQuality.Bad => "bad",
        ActivityQuality.Neutral => "neutral",
        _ => "none"
    };

    private string GetQualityTitle(ActivityQuality q)
        => q switch
        {
            ActivityQuality.Good => IsLt ? $"{GetActivityShortLabel(_selectedActivity)}: palanku" : $"{GetActivityShortLabel(_selectedActivity)}: Good",
            ActivityQuality.Bad => IsLt ? $"{GetActivityShortLabel(_selectedActivity)}: nepalanku" : $"{GetActivityShortLabel(_selectedActivity)}: Bad",
            ActivityQuality.Neutral => IsLt ? $"{GetActivityShortLabel(_selectedActivity)}: neutralu" : $"{GetActivityShortLabel(_selectedActivity)}: Neutral",
            _ => $"{GetActivityShortLabel(_selectedActivity)}: —"
        };
    
    private string BuildGoodBadTagsHtml(AstroEvent? e)
    {
        if (e is null) return "";

        var tags = _activities
            .Select(a => new { A = a, Q = GetActivityQuality(e, a) })
            .Where(x => x.Q == ActivityQuality.Good || x.Q == ActivityQuality.Bad)
            .Select(x =>
            {
                var cls = x.Q == ActivityQuality.Good ? "tag-good" : "tag-bad";
                var title = EnumText.GetActivityName(x.A);
                var iconPath = WebUtility.HtmlEncode(GetActivityIconPath(x.A));
                var safeTitle = WebUtility.HtmlEncode(title);
                return $@"<div class=""gb-tag {cls}"" title=""{safeTitle}"">
                        <span class=""gb-tag__icon"" aria-hidden=""true""><img class=""activity-icon-img"" src=""{iconPath}"" alt="""" /></span>
                        <span class=""gb-tag__label"">{safeTitle}</span>
                      </div>";
            })
            .ToList();

        if (tags.Count == 0)
            return IsLt ? @"<div class=""gb-tags-empty muted"">Šiai dienai nėra palankių / nepalankių veiklų.</div>" : @"<div class=""gb-tags-empty muted"">No Good/Bad tags for this day.</div>";

        return $@"<div class=""gb-tags"">{string.Join("", tags)}</div>";
    }



    // Shared right panel content (Razor template — safer than manual __builder markup)
    private RenderFragment RightPanelContent() => @<div class="day-layout">
        <div class="month-row">@_current.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</div>
        <div class="daynum-row">@_current.Day</div>
        <div class="weekday-row">@_current.ToString("dddd", CultureInfo.CurrentCulture)</div>

        @{
            var mo = _monthEvents.FirstOrDefault(x => x.Date.Date == _current.Date);

            double ToDayPercent(DateTime dt)
            {
                var seconds = dt.TimeOfDay.TotalSeconds;
                var pct = (seconds / 86399.0) * 100.0;
                if (pct < 0) pct = 0;
                if (pct > 100) pct = 100;
                return pct;
            }
        }

        @* Moon-day timeline *@
        @if (mo?.MoonDay is not null)
        {
            var md = mo.MoonDay!;

            var prevIcon = GetMoonDayKey(md.PreviousMoonDay);
            var newIcon  = GetMoonDayKey(md.NewMoonDay);
            var prevTitle = GetMoonDayName(md.PreviousMoonDay);
            var newTitle  = GetMoonDayName(md.NewMoonDay);

            var endPct = ToDayPercent(md.TransitionTime);
            var endTimeText = md.TransitionTime.ToString("HH:mm", CultureInfo.InvariantCulture);

            <div class="moonday-row">
                <div class="astro-frame astro-frame--moonday">
                    <div class="md-timeline">
                        <div class="md-side md-side--left" title="@prevTitle">
                            <button type="button" class="icon-btn" title="@prevTitle" @onclick="(() => OpenMoonDayDetails(md.PreviousMoonDay))">
                                <img alt="Previous Moon Day" src="@($"img/zodiac/{prevIcon}.png")" />
                            </button>
                        </div>

                        <div class="md-line-wrap">
                            <div class="md-line"></div>

                            @if (md.IsTripleMoonDay)
                            {
                                var midPct = ToDayPercent(md.MiddleMoonDayTransitionTime);
                                var midTimeText = md.MiddleMoonDayTransitionTime.ToString("HH:mm", CultureInfo.InvariantCulture);
                                var midIcon = GetMoonDayKey(md.MiddleMoonDay);
                                var midTitle = GetMoonDayName(md.MiddleMoonDay);

                                <div class="md-marker md-marker--mid" style="--target:@Css.Pct(midPct)" title="@($"Middle transition: {midTimeText}")">
                                    <div class="md-marker-bar"></div>
                                    <div class="md-marker-label">@midTimeText</div>
                                </div>

                                <button type="button"
                                        class="icon-btn md-mini"
                                        style="--target:@Css.Pct(midPct)"
                                        title="@midTitle"
                                        @onclick="(() => OpenMoonDayDetails(md.MiddleMoonDay))">
                                    <img alt="Middle Moon Day" src="@($"img/zodiac/{midIcon}.png")" />
                                </button>
                            }

                            <div class="md-marker md-marker--final" style="--target:@Css.Pct(endPct)" title="@($"Transition: {endTimeText}")">
                                <div class="md-marker-bar"></div>
                                <div class="md-marker-label">@endTimeText</div>
                            </div>
                        </div>

                        <div class="md-side md-side--right" title="@newTitle">
                            <button type="button" class="icon-btn" title="@newTitle" @onclick="(() => OpenMoonDayDetails(md.NewMoonDay))">
                                <img alt="New Moon Day" src="@($"img/zodiac/{newIcon}.png")" />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="moonday-row"><span class="muted">@(IsLt ? "Nėra Mėnulio dienos simbolio" : "No Moon-day symbol")</span></div>
        }

        @{
            var first = DayEvents.FirstOrDefault();

            var sunBlock     = BuildZodiacOrTransitionBlock(EnumText.GetPlanetName(Planet.Sun), first?.SunInZodiac);
            var moonBlock    = BuildZodiacOrTransitionBlock(EnumText.GetPlanetName(Planet.Moon), first?.MoonInZodiac);
            var mercuryBlock = BuildZodiacOrTransitionBlock(EnumText.GetPlanetName(Planet.Mercury), first?.MercuryInZodiac);
            var venusBlock   = BuildZodiacOrTransitionBlock(EnumText.GetPlanetName(Planet.Venus), first?.VenusInZodiac);
            var marsBlock    = BuildZodiacOrTransitionBlock(EnumText.GetPlanetName(Planet.Mars), first?.MarsInZodiac);
        }

        @* Planets-in-zodiac frame *@
        <div class="astro-frame astro-frame--planets">
            <div class="planet-grid planet-grid--top">
                <div class="planet-cell">
                    <button type="button" class="icon-btn" title="Sun" @onclick="(() => OpenPlanetInZodiacDetails(first?.SunInZodiac))">
                        <img class="planet-icon" alt="Sun" src="img/zodiac/sun.png" width="40" height="40" />
                    </button>
                    <div class="planet-zodiac">@((MarkupString)sunBlock)</div>
                </div>
                <div class="planet-cell">
                    <button type="button" class="icon-btn" title="Moon" @onclick="(() => OpenPlanetInZodiacDetails(first?.MoonInZodiac))">
                        <img class="planet-icon" alt="Moon" src="img/zodiac/moon.png" width="40" height="40" />
                    </button>
                    <div class="planet-zodiac">@((MarkupString)moonBlock)</div>
                </div>
            </div>

            <div class="planet-grid planet-grid--bottom">
                <div class="planet-cell">
                    <button type="button" class="icon-btn" title="Mercury" @onclick="(() => OpenPlanetInZodiacDetails(first?.MercuryInZodiac))">
                        <img class="planet-icon" alt="Mercury" src="img/zodiac/mercury.png" width="40" height="40" />
                    </button>
                    <div class="planet-zodiac">@((MarkupString)mercuryBlock)</div>
                </div>
                <div class="planet-cell">
                    <button type="button" class="icon-btn" title="Venus" @onclick="(() => OpenPlanetInZodiacDetails(first?.VenusInZodiac))">
                        <img class="planet-icon" alt="Venus" src="img/zodiac/venus.png" width="40" height="40" />
                    </button>
                    <div class="planet-zodiac">@((MarkupString)venusBlock)</div>
                </div>
                <div class="planet-cell">
                    <button type="button" class="icon-btn" title="Mars" @onclick="(() => OpenPlanetInZodiacDetails(first?.MarsInZodiac))">
                        <img class="planet-icon" alt="Mars" src="img/zodiac/mars.png" width="40" height="40" />
                    </button>
                    <div class="planet-zodiac">@((MarkupString)marsBlock)</div>
                </div>
            </div>
        </div>

        @* Events frame *@
        @if (DayEvents.Any())
        {
            var items = GetEventDisplayItems();

            if (items.Count > 0)
            {
                var hasDescriptions = items.Any(x => !string.IsNullOrWhiteSpace(x.Description));

                <div class="astro-frame astro-frame--events @(hasDescriptions ? "is-clickable" : "")"
                     role="@(hasDescriptions ? "button" : null)"
                     tabindex="@(hasDescriptions ? "0" : null)"
                     @onclick="OpenEventTextDetails"
                     @onkeydown="HandleEventTextKeyDown">
                    <ul class="events-list">
                        @foreach (var item in items)
                        {
                            <li>
                                <span class="event-title">@item.Title</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

        @* Good/Bad tags (bottom) *@
        @{
            var tagsHtml = BuildGoodBadTagsHtml(first);
        }
        <div class="gb-tags-wrap">@((MarkupString)tagsHtml)</div>

    </div>;

    private void OpenMoonDayDetails(int moonDay)
    {
        var name = GetMoonDayName(moonDay);

        var info = GetMoonDayInfo(_db?.MoonDayDetailsDB?
            .FirstOrDefault(x => x.MoonDay == moonDay));

        _infoModalTitle = IsLt ? $"Mėnulio diena {moonDay} · {name}" : $"Moon Day {moonDay} · {name}";
        _infoModalBody = ToMultilineMarkup(info, IsLt ? "Šiam simboliui Mėnulio dienos aprašymo dar nėra." : "No Moon-day details saved yet for this symbol.");
        _infoModalOpen = true;
    }

    private void OpenPlanetInZodiacDetails(PlanetInZodiac? p)
    {
        if (p is null)
        {
            _infoModalTitle = IsLt ? "Detalės" : "Details";
            _infoModalBody = ToMultilineMarkup(null, IsLt ? "Šiai dienai planetos duomenų nėra." : "No planet data for this day.");
            _infoModalOpen = true;
            return;
        }

        var planetName = EnumText.GetPlanetName(p.Planet);
        var signName = EnumText.GetZodiacName(p.NewZodiacSign);

        var info = GetPlanetInZodiacInfo(_db?.PlanetInZodiacsDB?
            .FirstOrDefault(x => x.Planet == p.Planet && x.ZodiacSign == p.NewZodiacSign));

        _infoModalTitle = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt" ? $"{planetName} {EnumText.GetZodiacLocative(p.NewZodiacSign)}" : $"{planetName} in {signName}";
        _infoModalBody = ToMultilineMarkup(info, IsLt ? "Šiai padėčiai planetos ženkle aprašymo dar nėra." : "No Planet-in-Zodiac details saved yet for this position.");
        _infoModalOpen = true;
    }

    private void CloseInfoModal()
    {
        _infoModalOpen = false;
        _infoModalTitle = "";
        _infoModalBody = default;
    }

    private string GetMoonDayInfo(MoonDayDetails? details)
        => LocalizedInterpretation(details?.MoonDayInfo, details?.MoonDayInfoEn);

    private string GetPlanetInZodiacInfo(PlanetInZodiacDetails? details)
        => LocalizedInterpretation(details?.PlanetInZodiacInfo, details?.PlanetInZodiacInfoEn);

    private string LocalizedInterpretation(string? lt, string? en)
    {
        if (IsLt)
            return lt ?? "";

        return !string.IsNullOrWhiteSpace(en) ? en : (lt ?? "");
    }

    private static MarkupString BuildEventTextModalBody(IReadOnlyList<EventDisplayItem> items)
    {
        var sections = items.Select(item =>
            "<section class=\"info-modal__event\">" +
            $"<div class=\"info-modal__event-title\">{WebUtility.HtmlEncode(item.Title)}</div>" +
            $"<div class=\"info-modal__text\">{EncodeMultilineText(item.Description)}</div>" +
            "</section>");

        return new MarkupString(string.Join("", sections));
    }

    private static MarkupString ToMultilineMarkup(string? text, string emptyMessage)
    {
        var raw = string.IsNullOrWhiteSpace(text) ? emptyMessage : text;
        var html = EncodeMultilineText(raw);
        return new MarkupString($"<div class=\"info-modal__text\">{html}</div>");
    }

    private static string EncodeMultilineText(string raw)
        => WebUtility.HtmlEncode(raw).Replace("\r\n", "<br/>").Replace("\n", "<br/>");
}
