@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@using System.Globalization

<div class="app-shell">
  <header class="app-header">
    <div class="header-row">
      <div class="brand-block">
        <button type="button"
                class="brand-trigger"
                title="@(IsLt ? "Atidaryti Astrodaiva svetainę" : "Open Astrodaiva website")"
                @onclick="OpenAstrodaivaWebsite">
          <img class="brand-logo"
               src="img/astrodaiva-logo.png"
               alt="Astrodaiva" />
        </button>

        <nav class="main-nav @(IsYearPage ? "is-year" : "is-home")">
          <span class="main-nav__slider" aria-hidden="true"></span>
          <NavLink class="main-nav__link" href="" Match="NavLinkMatch.All">@(IsLt ? "Pradžia" : "Home")</NavLink>
          <NavLink class="main-nav__link" href="year">@(IsLt ? "Metai" : "Year")</NavLink>
        </nav>
      </div>

      <div class="header-actions">
        <div class="lang-switcher lang-switcher--select">
          <select class="lang-select"
                  aria-label="@(IsLt ? "Kalba" : "Language")"
                  value="@SelectedCulture"
                  @onchange="OnLanguageChanged">
            <option value="lt-LT">LT</option>
            <option value="en-US">EN</option>
          </select>
        </div>
      </div>
    </div>
  </header>

  <main class="container app-main">
    <div class="body">
      @Body
    </div>
  </main>
</div>

@code {
    private bool IsLt => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt";
    private bool IsYearPage => Nav.Uri.Contains("/year", StringComparison.OrdinalIgnoreCase);
    private string SelectedCulture => IsLt ? "lt-LT" : "en-US";

    private Task SetLt() => SetCulture("lt-LT");
    private Task SetEn() => SetCulture("en-US");

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(culture) ||
            string.Equals(culture, SelectedCulture, StringComparison.OrdinalIgnoreCase))
            return;

        await SetCulture(culture);
    }

    private async Task SetCulture(string culture)
    {
        await JS.InvokeAsync<object>("blazorCulture.set", culture);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task OpenAstrodaivaWebsite()
    {
        var message = IsLt
            ? "Ar norite atidaryti Astrodaiva svetainę?"
            : "Do you want to open the Astrodaiva website?";

        var shouldOpen = await JS.InvokeAsync<bool>("confirm", message);
        if (!shouldOpen)
            return;

        await JS.InvokeVoidAsync("open", "https://www.astrodaiva.com", "_blank", "noopener,noreferrer");
    }
}
