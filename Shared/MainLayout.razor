@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@using System.Globalization

<div class="app-shell">
  <header class="app-header">
    <div class="header-row">
      <div class="brand-block">
        <button type="button"
                class="brand-trigger"
                title="@(IsLt ? "Atidaryti Astrodaiva svetainę" : "Open Astrodaiva website")"
                @onclick="ShowWebsitePrompt">
          <img class="brand-logo"
               src="img/astrodaiva-logo.png"
               alt="Astrodaiva" />
        </button>

        <nav class="main-nav @(IsYearPage ? "is-year" : "is-home")">
          <span class="main-nav__slider" aria-hidden="true"></span>
          <NavLink class="main-nav__link" href="" Match="NavLinkMatch.All">@(IsLt ? "Pradžia" : "Home")</NavLink>
          <NavLink class="main-nav__link" href="year">@(IsLt ? "Metai" : "Year")</NavLink>
        </nav>
      </div>

      <div class="header-actions">
        <div class="lang-switcher" role="group" aria-label="@(IsLt ? "Kalba" : "Language")">
          <button type="button" class="lang-btn @(IsLt ? "active" : null)"
                  lang="lt" aria-label="Lietuvių" title="Lietuvių"
                  aria-pressed="@(IsLt ? "true" : "false")" @onclick="SetLt">LT</button>
          <button type="button" class="lang-btn @(!IsLt ? "active" : null)"
                  lang="en" aria-label="English" title="English"
                  aria-pressed="@(!IsLt ? "true" : "false")" @onclick="SetEn">EN</button>
        </div>
      </div>
    </div>
  </header>

  <main class="container app-main">
    <div class="body">
      @Body
    </div>
  </main>
</div>

@if (_showWebsitePrompt)
{
  <div class="website-prompt" role="dialog" aria-modal="true" aria-label="@(IsLt ? "Atidaryti Astrodaiva svetainę" : "Open Astrodaiva website")">
    <div class="website-prompt__backdrop" @onclick="CloseWebsitePrompt"></div>
    <div class="website-prompt__panel">
      <div class="website-prompt__message">
        @(IsLt ? "Ar norite atidaryti Astrodaiva svetainę?" : "Do you want to open the Astrodaiva website?")
      </div>

      <div class="website-prompt__actions">
        <button type="button" class="lang-btn" @onclick="CloseWebsitePrompt">
          @(IsLt ? "Atšaukti" : "Cancel")
        </button>
        <a class="lang-btn active website-prompt__link"
           href="https://www.astrodaiva.com"
           target="_blank"
           rel="noopener noreferrer"
           @onclick="CloseWebsitePrompt">
          @(IsLt ? "Atidaryti" : "Open")
        </a>
      </div>
    </div>
  </div>
}

@code {
    private bool _showWebsitePrompt;

    private bool IsLt => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "lt";
    private bool IsYearPage => Nav.Uri.Contains("/year", StringComparison.OrdinalIgnoreCase);
    private string SelectedCulture => IsLt ? "lt-LT" : "en-US";

    private Task SetLt() => SetCulture("lt-LT");
    private Task SetEn() => SetCulture("en-US");

    private async Task SetCulture(string culture)
    {
        if (string.Equals(culture, SelectedCulture, StringComparison.OrdinalIgnoreCase))
            return;

        await JS.InvokeAsync<object>("blazorCulture.set", culture);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private void ShowWebsitePrompt() => _showWebsitePrompt = true;

    private void CloseWebsitePrompt() => _showWebsitePrompt = false;
}
