@using Astrodaiva.Blazor.Services
@using Microsoft.AspNetCore.Components.Routing
@using Astrodaiva.Blazor.Shared
@using System.Globalization
@inject AstroDbStore Store
@implements IDisposable

@if (!_bootAttempted)
{
    <div class="boot-screen">
        <div class="boot-card" role="status" aria-live="polite">
            <div class="boot-brand" aria-label="Astrodaiva Kalendorius">
                <img class="boot-logo"
                     src="img/astrodaiva-logo.svg"
                     alt="Astrodaiva Kalendorius" />
            </div>
            <div class="boot-progress" aria-hidden="true">
                <span></span>
            </div>
            <div class="boot-status">@BootLoadingText</div>
        </div>
    </div>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@if (_showServerSnackbar)
{
    <div class="app-snackbar" role="status" aria-live="polite">
        <span class="app-snackbar__message">@_serverSnackbarMessage</span>
        <span class="app-snackbar__actions">
            <button type="button" class="app-snackbar__button" @onclick="DismissServerSnackbar">OK</button>
            @if (_showServerRetry)
            {
                <button type="button" class="app-snackbar__button app-snackbar__button--retry" @onclick="RetryServerConnection" disabled="@_isRetryingServer">
                    @RetryButtonText
                </button>
            }
        </span>
    </div>
}

@code {
    private bool _bootAttempted;
    private bool _showServerSnackbar;
    private bool _showServerRetry;
    private bool _isRetryingServer;
    private bool _serverUnavailableSeen;
    private string _serverSnackbarMessage = ServerUnavailableText;
    private static bool IsLt =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("lt", StringComparison.OrdinalIgnoreCase);

    private static string BootLoadingText =>
        IsLt ? "Kraunasi" : "Loading";

    private static string ServerUnavailableText =>
        IsLt ? "Serveris nepasiekiamas" : "Server unavailable";

    private static string RetryButtonText =>
        IsLt ? "Bandyti" : "Retry";

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        Store.ServerUnavailable += OnServerUnavailable;
        Store.ServerAvailable += OnServerAvailable;

        // Kick off a single, app-wide load attempt (same Store instance for all pages).
        await Store.EnsureLoadedAsync();

        _bootAttempted = true;
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private void OnServerUnavailable()
    {
        _serverUnavailableSeen = true;
        _serverSnackbarMessage = ServerUnavailableText;
        _showServerRetry = true;
        _showServerSnackbar = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnServerAvailable()
    {
        if (!_serverUnavailableSeen)
            return;

        _showServerRetry = false;
        _showServerSnackbar = false;
        _serverUnavailableSeen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void DismissServerSnackbar()
    {
        _showServerSnackbar = false;
    }

    private async Task RetryServerConnection()
    {
        if (_isRetryingServer)
            return;

        _isRetryingServer = true;
        StateHasChanged();

        try
        {
            var serverReached = await Store.RetryDefaultSnapshotAsync();
            _showServerRetry = !serverReached;
            _showServerSnackbar = !serverReached;
            _serverSnackbarMessage = ServerUnavailableText;

            if (serverReached)
                _serverUnavailableSeen = false;
        }
        finally
        {
            _isRetryingServer = false;
        }
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Store.ServerUnavailable -= OnServerUnavailable;
        Store.ServerAvailable -= OnServerAvailable;
    }
}
