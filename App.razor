@using Astrodaiva.Blazor.Services
@using Microsoft.AspNetCore.Components.Routing
@using Astrodaiva.Blazor.Shared
@using System.Globalization
@using Microsoft.JSInterop
@inject AstroDbStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (!_bootAttempted)
{
    <div class="boot-screen">
        <div class="boot-card" role="status" aria-live="polite">
            <div class="boot-brand" aria-label="Astrodaiva Kalendorius">
                <img class="boot-logo"
                     src="img/astrodaiva-logo.png"
                     alt="Astrodaiva" />
            </div>
            <div class="boot-progress" aria-hidden="true">
                <span></span>
            </div>
            <div class="boot-status">@BootLoadingText</div>
        </div>
    </div>
}
else if (Store.Db is null)
{
    <div class="boot-screen">
        <div class="boot-card boot-card--error" role="status" aria-live="polite">
            <div class="boot-brand" aria-label="Astrodaiva Kalendorius">
                <img class="boot-logo"
                     src="img/astrodaiva-logo.png"
                     alt="Astrodaiva" />
            </div>
            <div class="boot-status">@BootFailedText</div>
            <p class="boot-message">@BootFailedHelp</p>
            <button type="button"
                    class="boot-retry"
                    @onclick="RetryInitialDataLoad"
                    disabled="@_isRetryingInitialData">
                @RetryInitialLoadText
            </button>
        </div>
    </div>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@if (_showAnalyticsConsent)
{
    <div class="analytics-consent" role="dialog" aria-live="polite" aria-label="@AnalyticsConsentTitle">
        <div class="analytics-consent__text">
            <strong>@AnalyticsConsentTitle</strong>
            <span>@AnalyticsConsentText</span>
        </div>
        <div class="analytics-consent__actions">
            <button type="button" class="analytics-consent__button" @onclick="DeclineAnalytics">
                @(IsLt ? "Ne" : "No thanks")
            </button>
            <button type="button" class="analytics-consent__button analytics-consent__button--primary" @onclick="AcceptAnalytics">
                @(IsLt ? "Sutinku" : "Accept")
            </button>
        </div>
    </div>
}

@if (_showServerSnackbar)
{
    <div class="app-snackbar" role="status" aria-live="polite">
        <span class="app-snackbar__message">@_serverSnackbarMessage</span>
        <span class="app-snackbar__actions">
            <button type="button" class="app-snackbar__button" @onclick="DismissServerSnackbar">OK</button>
            @if (_showServerRetry)
            {
                <button type="button" class="app-snackbar__button app-snackbar__button--retry" @onclick="RetryServerConnection" disabled="@_isRetryingServer">
                    @RetryButtonText
                </button>
            }
        </span>
    </div>
}

@code {
    private bool _bootAttempted;
    private bool _showServerSnackbar;
    private bool _showServerRetry;
    private bool _isRetryingServer;
    private bool _isRetryingInitialData;
    private bool _serverUnavailableSeen;
    private bool _analyticsConsentChecked;
    private bool _showAnalyticsConsent;
    private string _serverSnackbarMessage = ServerUnavailableText;
    private static bool IsLt =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("lt", StringComparison.OrdinalIgnoreCase);

    private static string BootLoadingText =>
        IsLt ? "Kraunasi" : "Loading";

    private static string ServerUnavailableText =>
        IsLt ? "Serveris nepasiekiamas" : "Server unavailable";

    private static string RetryButtonText =>
        IsLt ? "Bandyti" : "Retry";

    private static string RetryInitialLoadText =>
        IsLt ? "Bandyti dar kartą" : "Try again";

    private static string BootFailedText =>
        IsLt ? "Nepavyko įkelti duomenų" : "Could not load data";

    private static string BootFailedHelp =>
        IsLt
            ? "Patikrinkite interneto ryšį ir bandykite dar kartą."
            : "Check your connection and try again.";

    private static string AnalyticsConsentTitle =>
        IsLt ? "Analitika" : "Analytics";

    private static string AnalyticsConsentText =>
        IsLt
            ? "Padėkite suprasti, kaip naudojamas Astrodaiva kalendorius."
            : "Help us understand how the Astrodaiva calendar is used.";

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Store.Changed += OnStoreChanged;
        Store.ServerUnavailable += OnServerUnavailable;
        Store.ServerAvailable += OnServerAvailable;

        // Kick off a single, app-wide load attempt (same Store instance for all pages).
        await Store.EnsureLoadedAsync();

        _bootAttempted = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_analyticsConsentChecked)
        {
            _analyticsConsentChecked = true;

            var consent = await JS.InvokeAsync<string>("astroAnalytics.getConsent");
            _showAnalyticsConsent = string.Equals(consent, "unset", StringComparison.OrdinalIgnoreCase) &&
                                    !IsAdminRoute(Nav.Uri);
            await TrackCurrentPageAsync();

            if (_showAnalyticsConsent)
                StateHasChanged();
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private void OnServerUnavailable()
    {
        _serverUnavailableSeen = true;
        _serverSnackbarMessage = ServerUnavailableText;
        _showServerRetry = true;
        _showServerSnackbar = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnServerAvailable()
    {
        if (!_serverUnavailableSeen)
            return;

        _showServerRetry = false;
        _showServerSnackbar = false;
        _serverUnavailableSeen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void DismissServerSnackbar()
    {
        _showServerSnackbar = false;
    }

    private async Task RetryServerConnection()
    {
        if (_isRetryingServer)
            return;

        _isRetryingServer = true;
        StateHasChanged();

        try
        {
            var serverReached = await Store.RetryDefaultSnapshotAsync();
            _showServerRetry = !serverReached;
            _showServerSnackbar = !serverReached;
            _serverSnackbarMessage = ServerUnavailableText;

            if (serverReached)
                _serverUnavailableSeen = false;
        }
        finally
        {
            _isRetryingServer = false;
        }
    }

    private async Task RetryInitialDataLoad()
    {
        if (_isRetryingInitialData)
            return;

        _isRetryingInitialData = true;
        StateHasChanged();

        try
        {
            await Store.RetryDefaultSnapshotAsync();

            if (Store.Db is null)
                await Store.ReloadFromLocalAsync();
        }
        finally
        {
            _isRetryingInitialData = false;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsAdminRoute(e.Location) && _showAnalyticsConsent)
        {
            _showAnalyticsConsent = false;
            _ = InvokeAsync(StateHasChanged);
        }

        _ = TrackCurrentPageAsync(e.Location);
    }

    private static bool IsAdminRoute(string location)
    {
        if (!Uri.TryCreate(location, UriKind.Absolute, out var uri))
            return false;

        return uri.AbsolutePath.Equals("/admin", StringComparison.OrdinalIgnoreCase) ||
               uri.AbsolutePath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);
    }

    private async Task TrackCurrentPageAsync(string? location = null)
    {
        try
        {
            await JS.InvokeVoidAsync("astroAnalytics.trackPageView", location ?? Nav.Uri, "Astrodaiva");
        }
        catch
        {
            // Analytics must never block app navigation or rendering.
        }
    }

    private async Task AcceptAnalytics()
    {
        _showAnalyticsConsent = false;
        await JS.InvokeVoidAsync("astroAnalytics.setConsent", true);
        await TrackCurrentPageAsync();
    }

    private async Task DeclineAnalytics()
    {
        _showAnalyticsConsent = false;
        await JS.InvokeVoidAsync("astroAnalytics.setConsent", false);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Store.Changed -= OnStoreChanged;
        Store.ServerUnavailable -= OnServerUnavailable;
        Store.ServerAvailable -= OnServerAvailable;
    }
}
